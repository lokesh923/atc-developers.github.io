# Accenture full exam simulation (static page, served directly; WordPress is not involved)
# Lets Graphy show this page in an iframe and lets the page use the microphone (Communication round).
<IfModule mod_headers.c>
    Header always unset X-Frame-Options
    Header always set Content-Security-Policy "frame-ancestors *"
    Header always set Permissions-Policy "microphone=*, autoplay=*, fullscreen=*, clipboard-write=*"
</IfModule>
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html
</IfModule>
DirectoryIndex index.html
